// An ambient piece in D aeolian, about three minutes at 70 bpm.
//
// The cycle: i7 - VImaj7sus2 - IIImaj7 - VIIsus4 - VII - VIIsus2, six bars.
// Dm7's 7th (C) is held into Bbmaj7sus2 as its 2nd; Csus4's 4th (F)
// resolves to E, then falls to D, the sus2, which is the next Dm7's root.
// Every harmony is pinned to D aeolian, so tensions and passing notes are
// diatonic.
section "intro" bars=8 {
    harmony "D aeolian" bars=8
}
section "a" bars=12 {
    harmony "Dm7" bars=2 scale="D aeolian"
    harmony "Bbmaj7sus2" "Fmaj7" "Csus4" bars=1 scale="D aeolian"
    harmony "C" "Csus2" beats=2 scale="D aeolian"
    harmony "Dm7" bars=2 scale="D aeolian"
    harmony "Bbmaj7sus2" "Fmaj7" "Csus4" bars=1 scale="D aeolian"
    harmony "C" "Csus2" beats=2 scale="D aeolian"
}
section "b" bars=12 {
    harmony "Dm9" bars=2 scale="D aeolian"
    harmony "Bbmaj7sus2" "Fmaj9" "Csus4" bars=1 scale="D aeolian"
    harmony "C" "Csus2" beats=2 scale="D aeolian"
    harmony "Dm9" bars=2 scale="D aeolian"
    harmony "Bbmaj7sus2" "Fmaj9" "Csus4" bars=1 scale="D aeolian"
    harmony "C" "Csus2" beats=2 scale="D aeolian"
}
section "c" bars=12 {
    harmony "Dm9" bars=2 scale="D aeolian"
    harmony "Bbmaj7sus2" "Fmaj9" "Csus4" bars=1 scale="D aeolian"
    harmony "C" "Csus2" beats=2 scale="D aeolian"
    harmony "Dm11" bars=2 scale="D aeolian"
    harmony "Bbmaj7sus2" "Fmaj9" "Csus4" bars=1 scale="D aeolian"
    harmony "C" "Csus2" beats=2 scale="D aeolian"
}
section "outro" bars=8 {
    harmony "Dm7" bars=4 scale="D aeolian"
    harmony "Bbmaj7sus2" bars=2 scale="D aeolian"
    harmony "Dm9" bars=2 scale="D aeolian"
}

// A D pedal under everything (root of Dm, 3rd of Bb, 6th of F, 9th of
// C), with each harmony's fifth above it. 16': sounds an octave down.
part "Drone" {
    voicing "root fifth" voices=2 range="D2..A3"
    pedal "D2"
}
// Close voicings, so each voice's step is heard, with passing notes and
// suspensions between them.
part "Pad" {
    voicing "close" voices=4 range="A3..E5"
    nct "suspension" "passing" beats=1
    // Dm7's C held, in the same voice, as Bbmaj7sus2's 2nd.
    fix "a" bar=1 "C4 D4 F4 A4"
    fix "a" bar=3 "C4 F4 A4 Bb4"
    fix "a" bar=9 "C4 F4 A4 Bb4"
    fix "b" bar=3 "C4 F4 A4 Bb4"
    fix "b" bar=9 "C4 F4 A4 Bb4"
    fix "c" bar=3 "C4 F4 A4 Bb4"
    fix "c" bar=9 "C4 F4 A4 Bb4"
    feel velocity=3 seed=1
}
// A slow arpeggio over the guide tones and a tension.
part "Glass" {
    in "b" "c" "outro"
    voicing "guide tones" voices=3 range="D4..D6"
    articulation "drift"
    feel timing=18 velocity=8 seed=2
}
// A soft heartbeat on each root (16').
part "Pulse" {
    in "a" "b" "c"
    voicing "root fifth" voices=2 range="D2..A3"
    articulation "heartbeat"
    feel velocity=4 seed=3
}
// One held note of white noise per harmony; volume automation shapes it.
part "Hiss" {
    voicing "close" voices=1 range="C4..C5"
}
