// Shimmer: modulation at different rates that drift in and out of phase.
// Internal wobbles: vibrato, filter vibrato and chorus at different speeds.
set Glass Kritter Vibrato 1 normalised=#true
set Glass Kritter "Vibrato Speed" 0.15 normalised=#true
set Glass Kritter "Vibrato Depth" 0.18 normalised=#true
set Pad Kritter Vibrato 0 normalised=#true
set Pad Kritter "Cutoff Vibrato" 1 normalised=#true
set Pad Kritter "Vibrato Speed" 0 normalised=#true
set Pad Kritter "Vibrato Depth" 0.3 normalised=#true
set Pad Kritter "Chorus Rate" 0.2 normalised=#true
set Drone Kritter "Chorus Rate" 0 normalised=#true
set Drone Kritter "Chorus Depth" 1 normalised=#true
set Drone Kritter "Chorus Drift" 0.5 normalised=#true
set Hiss Kritter "Chorus Rate" 1 normalised=#true
set Hiss Kritter "Chorus Depth" 0.8 normalised=#true
set Hiss Kritter "Chorus Ripple" 0.4 normalised=#true
set Hiss Kritter "Chorus Drift" 0.3 normalised=#true
commit
